{
  "name": "news-aggregator",
  "private": true,
  "version": "1.0.0",
  "description": "F.VNN (Vietnamese News) — ứng dụng desktop tổng hợp tin tức, phong cách Apple.",
  "author": "F.VNN",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:win": "vite build && electron-builder --win --x64",
    "dist:win:publish": "vite build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "dompurify": "^3.4.13",
    "framer-motion": "^11.11.17",
    "lenis": "^1.3.26",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.fvnn.newsaggregator",
    "productName": "F.VNN",
    "publish": {
      "provider": "github",
      "owner": "wwwxadieu",
      "repo": "F.Tuning-Pro",
      "releaseType": "release"
    },
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "F.VNN-Setup-${version}.${ext}"
    }
  }
}
